# 敏感信息（API密钥等）在CloudBase控制台中设置

## 微信小程序
APP_ID=wx19349197c537e97e

## CloudBase 云开发
CLOUDBASE_ENV_ID=logistics-tracker-prod-d7bae6369

## 快递100
KUAIDI100_KEY=UEPLKXkF9092
KUAIDI100_CUSTOMER=07D4624843A9E1EAFBE8C49504ACE65F

## 云函数环境变量（需在 CloudBase 控制台手动设置）
# 云函数 api-gateway / tracking-worker / engine-controller / notification-sender
#   环境变量名: KUAIDI100_KEY
#   环境变量值: UEPLKXkF9092
#
#   环境变量名: KUAIDI100_CUSTOMER
#   环境变量值: 07D4624843A9E1EAFBE8C49504ACE65F
#
# 云函数 engine-controller 额外:
#   环境变量名: ENCRYPTION_KEY
#   环境变量值: (自行生成32位随机字符串, 可用 openssl rand -hex 16)
#
#   环境变量名: PLATFORMS
#   环境变量值: pdd
#
#   环境变量名: ENGINE_HOST
#   环境变量值: http://logistics-engine:3000

## 微信订阅消息模板ID（需在微信公众平台申请）
# TEMPLATE_ARRIVED=xxx
# TEMPLATE_SIGNED=xxx
