<!-- 包裹详情页 -->
<view class="page">
  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <block wx:else>
    <!-- 包裹信息卡片 -->
    <view class="card parcel-info">
      <view class="info-header">
        <text class="product-name">{{parcel.product_name}}</text>
        <text class="status-badge {{parcel.statusClass}}">{{parcel.statusText}}</text>
      </view>

      <view class="info-row">
        <text class="info-label">快递公司</text>
        <text class="info-value">{{parcel.courier}}</text>
      </view>
      <view class="info-row" catchtap="copyTracking">
        <text class="info-label">运单号</text>
        <text class="info-value tracking">{{parcel.trackingMasked}} 📋</text>
      </view>
      <view class="info-row">
        <text class="info-label">来源</text>
        <text class="info-value">{{parcel.platform === 'pdd' ? '拼多多' : parcel.platform === 'jd' ? '京东' : '淘宝'}}</text>
      </view>
      <view class="info-row" wx:if="{{parcel.arrivalTime}}">
        <text class="info-label">到达时间</text>
        <text class="info-value">{{parcel.arrivalTime}}</text>
      </view>
      <view class="info-row" wx:if="{{parcel.signedTime}}">
        <text class="info-label">签收时间</text>
        <text class="info-value">{{parcel.signedTime}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{parcel.orderTime}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <view class="action-btn" catchtap="toggleMute">
        <text>{{parcel.muted ? '🔔 取消静音' : '🔕 静音通知'}}</text>
      </view>
      <view class="action-btn danger" catchtap="deleteParcel">
        <text>🗑 删除</text>
      </view>
    </view>

    <!-- 物流时间线 -->
    <view class="card timeline-section">
      <text class="timeline-title">物流跟踪</text>

      <view class="timeline" wx:if="{{records.length > 0}}">
        <view
          class="timeline-item {{item.isKey ? 'key-event' : ''}}"
          wx:for="{{records}}"
          wx:key="index"
        >
          <view class="timeline-dot {{item.isKey ? 'key' : ''}}">
            <text wx:if="{{item.isKey}}">★</text>
          </view>
          <view class="timeline-content">
            <text class="timeline-context {{item.isKey ? 'bold' : ''}}">{{item.context}}</text>
            <text class="timeline-time">{{item.timeText}}</text>
            <text class="timeline-city" wx:if="{{item.city}}">{{item.city}}</text>
          </view>
        </view>
      </view>

      <view class="empty-state" wx:if="{{records.length === 0}}">
        <text>暂无物流记录</text>
      </view>
    </view>
  </block>
</view>
