/** 首页样式 */

.page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 30rpx;
}

.tab-item.active {
  background: #07c160;
  color: #fff;
  font-weight: 500;
}

/* 绑定引导 */
.bind-guide {
  margin: 20rpx 30rpx;
}

.bind-guide-content {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  border-radius: 16rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bind-guide-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.bind-guide-text {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 24rpx;
}

/* 包裹列表 */
.parcel-list {
  padding-bottom: 40rpx;
}

.parcel-card {
  position: relative;
}

.parcel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.courier {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.parcel-body {
  margin-bottom: 12rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tracking-number {
  font-size: 24rpx;
  color: #999;
}

.parcel-footer {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.mute-badge {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  font-size: 20rpx;
  color: #bbb;
}

.hidden {
  display: none;
}
