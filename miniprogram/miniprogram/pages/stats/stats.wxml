<!-- 统计页 -->
<view class="page">
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <block wx:else>
    <!-- 总览 -->
    <view class="card overview">
      <view class="overview-item">
        <text class="overview-number">{{stats && stats.total || 0}}</text>
        <text class="overview-label">累计包裹</text>
      </view>
      <view class="overview-item">
        <text class="overview-number">{{stats && stats.current_month || 0}}</text>
        <text class="overview-label">本月收件</text>
      </view>
    </view>

    <!-- 各平台占比 -->
    <view class="card chart-section">
      <text class="section-title">各平台包裹分布</text>
      <view class="platform-bar" wx:if="{{stats && stats.platforms}}">
        <view class="bar-row">
          <text class="bar-label">拼多多</text>
          <view class="bar-track">
            <view
              class="bar-fill pdd"
              style="width: {{calcPercent(stats.platforms.pdd, stats.total)}}%"
            ></view>
          </view>
          <text class="bar-count">{{stats.platforms.pdd}}</text>
        </view>
        <view class="bar-row">
          <text class="bar-label">京东</text>
          <view class="bar-track">
            <view
              class="bar-fill jd"
              style="width: {{calcPercent(stats.platforms.jd, stats.total)}}%"
            ></view>
          </view>
          <text class="bar-count">{{stats.platforms.jd}}</text>
        </view>
        <view class="bar-row">
          <text class="bar-label">淘宝</text>
          <view class="bar-track">
            <view
              class="bar-fill taobao"
              style="width: {{calcPercent(stats.platforms.taobao, stats.total)}}%"
            ></view>
          </view>
          <text class="bar-count">{{stats.platforms.taobao}}</text>
        </view>
      </view>
    </view>

    <!-- 常用快递 -->
    <view class="card chart-section">
      <text class="section-title">常用快递</text>
      <view class="courier-list" wx:if="{{stats && stats.couriers && stats.couriers.length}}">
        <view class="courier-item" wx:for="{{stats.couriers}}" wx:key="name">
          <text class="courier-name">{{item.name}}</text>
          <text class="courier-count">{{item.count}} 件</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{!stats || !stats.couriers || !stats.couriers.length}}">
        <text>暂无数据</text>
      </view>
    </view>
  </block>
</view>
