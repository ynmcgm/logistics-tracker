<!-- 账号绑定页 -->
<view class="page">
  <view class="card intro">
    <text class="intro-title">绑定电商账号</text>
    <text class="intro-desc">绑定后，小程序将自动同步您的订单和物流信息</text>
  </view>

  <view class="platform-list">
    <view
      class="platform-card card"
      wx:for="{{platforms}}"
      wx:key="key"
      data-platform="{{item.key}}"
      catchtap="onPlatformTap"
    >
      <view class="platform-icon">{{item.icon}}</view>
      <view class="platform-info">
        <text class="platform-name">{{item.name}}</text>
        <text class="platform-status {{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="platform-arrow">›</view>
    </view>
  </view>

  <!-- 绑定弹窗 -->
  <view class="qr-modal {{showQR ? '' : 'hidden'}}">
    <view class="qr-modal-mask" catchtap="closeQR"></view>
    <view class="qr-modal-content card">
      <view class="qr-header">
        <text class="qr-title">{{loginMode === 'sms' ? '短信验证' : '扫码授权'}}</text>
        <text class="qr-close" catchtap="closeQR">✕</text>
      </view>

      <!-- 模式切换（仅 PDD） -->
      <view class="mode-tabs" wx:if="{{currentPlatform === 'pdd' && loginStatus !== 'success'}}">
        <text class="mode-tab {{loginMode === 'qr' ? 'active' : ''}}" catchtap="switchToQr">扫码登录</text>
        <text class="mode-tab {{loginMode === 'sms' ? 'active' : ''}}" catchtap="switchToSms">短信登录</text>
      </view>

      <!-- ===== QR 扫码模式 ===== -->
      <view class="qr-body" wx:if="{{loginMode === 'qr'}}">
        <image class="qr-image" src="{{qrBase64}}" wx:if="{{qrBase64}}" mode="widthFix"></image>

        <view class="qr-status" wx:if="{{loginStatus === 'pending'}}">
          <text class="qr-hint">请用 {{platformName}} App 扫描二维码</text>
          <text class="qr-timeout">二维码有效期 300 秒</text>
        </view>

        <view class="qr-status success" wx:if="{{loginStatus === 'success'}}">
          <text class="qr-check">✓</text>
          <text>绑定成功！</text>
        </view>

        <view class="qr-status expired" wx:if="{{loginStatus === 'expired'}}">
          <text>二维码已过期</text>
          <view class="btn-primary" catchtap="retryBind">重新获取</view>
        </view>
      </view>

      <!-- ===== SMS 验证码模式 ===== -->
      <view class="sms-body" wx:if="{{loginMode === 'sms'}}">
        <!-- 手机号输入 -->
        <view class="sms-field">
          <text class="sms-label">手机号</text>
          <input class="sms-input" type="number" maxlength="11" placeholder="请输入手机号"
            value="{{phone}}" bindinput="onPhoneInput" />
        </view>

        <!-- 发送验证码按钮 -->
        <view class="sms-send-area" wx:if="{{!smsSent}}">
          <view class="btn-primary sms-send-btn" catchtap="sendSms">发送验证码</view>
        </view>

        <!-- 验证码输入 -->
        <view class="sms-field" wx:if="{{smsSent}}">
          <text class="sms-label">验证码</text>
          <input class="sms-input sms-code-input" type="number" maxlength="6" placeholder="输入 6 位验证码"
            value="{{smsCode}}" bindinput="onSmsCodeInput" />
          <view class="sms-resend" catchtap="sendSms" wx:if="{{smsCountdown === 0}}">重新发送</view>
          <text class="sms-countdown" wx:if="{{smsCountdown > 0}}">{{smsCountdown}}s</text>
        </view>

        <!-- 验证按钮 -->
        <view class="btn-primary sms-verify-btn" wx:if="{{smsSent}}" catchtap="verifySms">
          验证并登录
        </view>

        <!-- 错误信息 -->
        <text class="sms-error" wx:if="{{smsError}}">{{smsError}}</text>

        <!-- 提示 -->
        <text class="sms-hint">验证码将发送至您的拼多多绑定手机号</text>
      </view>
    </view>
  </view>
</view>
